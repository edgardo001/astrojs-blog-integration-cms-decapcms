---
import Layout from "../layouts/Layout.astro";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { BlogCollectionName } from "../content.config";

interface Props {
  post: CollectionEntry<BlogCollectionName>;
  basePath: string;
  backLabel: string;
}

const { post, basePath, backLabel } = Astro.props;
const { Content } = await render(post);

const base = import.meta.env.BASE_URL;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("es", { dateStyle: "long" }).format(date);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  type="article"
>
  <article class="post container">
    <header class="post__header">
      <a class="post__back" href={`${base}${basePath}`}>← {backLabel}</a>
      {
        post.data.image && (
          <img
            class="post__cover"
            src={`${base}${post.data.image.replace(/^\//, "")}`}
            alt={post.data.title}
          />
        )
      }
      <h1>{post.data.title}</h1>
      <p class="post__meta">
        {formatDate(post.data.pubDate)}
        {post.data.author ? ` · ${post.data.author}` : ""}
      </p>
      {post.data.tags?.length ? (
        <ul class="post__tags">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      ) : null}
    </header>

    <div class="post__body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post {
    padding-block: 3.5rem;
    max-width: 46rem;
  }

  .post__back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .post__back:hover {
    color: var(--color-accent);
  }

  .post__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
  }

  .post__header h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin-bottom: 0.75rem;
  }

  .post__meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .post__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0 0 2rem;
  }

  .post__tags li {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .post__body {
    color: var(--color-text);
  }

  .post__body h2,
  .post__body h3 {
    margin-top: 2rem;
  }

  .post__body img {
    border-radius: var(--radius);
  }

  .post__body code {
    background: var(--color-bg-soft);
    padding: 0.15rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.9em;
  }

  .post__body pre {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem;
    overflow-x: auto;
  }

  .post__body blockquote {
    margin-inline: 0;
    padding-inline: 1rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-text-muted);
  }
</style>
