---
const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}`, label: "Inicio" },
  { href: `${base}blog/`, label: "Blog" },
];
---

<header class="navbar">
  <div class="navbar__inner container">
    <a class="navbar__brand" href={base}>MiBlog</a>

    <button
      class="navbar__toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu"
      data-nav-toggle
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="menu" class="navbar__nav" data-nav>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a class="navbar__cta" href={`${base}admin/`}>Admin</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.querySelector("[data-nav]");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
  });
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.75rem;
  }

  .navbar__brand {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .navbar__brand:hover {
    text-decoration: none;
    color: var(--color-accent);
  }

  .navbar__toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .navbar__toggle span {
    width: 1.25rem;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .navbar__toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .navbar__toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .navbar__toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .navbar__nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: none;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .navbar__nav.is-open {
    display: block;
  }

  .navbar__nav ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .navbar__nav a {
    display: block;
    padding: 0.6rem 0.5rem;
    border-radius: var(--radius);
    color: var(--color-text);
    font-weight: 500;
  }

  .navbar__nav a:hover {
    background: var(--color-bg-soft);
    text-decoration: none;
    color: var(--color-accent);
  }

  .navbar__cta {
    color: var(--color-accent) !important;
  }

  @media (min-width: 48rem) {
    .navbar__toggle {
      display: none;
    }

    .navbar__nav {
      position: static;
      display: block;
      background: none;
      border-bottom: none;
    }

    .navbar__nav ul {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
      padding: 0;
    }

    .navbar__nav a {
      padding: 0.5rem 0.75rem;
    }
  }
</style>
