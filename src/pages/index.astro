---
import Layout from "../layouts/Layout.astro";
---

<Layout title="MiBlog — Inicio">
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">Blog con Astro y Decap CMS</p>
      <h1>Bienvenido a MiBlog</h1>
      <p class="hero__lead">
        Una landing page simple con un blog estático administrado desde Decap
        CMS. Rápido, responsivo y listo para crecer.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/blog/">Ver el blog</a>
        <a class="btn" href="/admin/">Administrar contenido</a>
      </div>
    </div>
  </section>

  <section class="features container">
    <div class="feature">
      <h2>Rápido</h2>
      <p>HTML estático generado por Astro con cero JavaScript innecesario.</p>
    </div>
    <div class="feature">
      <h2>Fácil de editar</h2>
      <p>Publica y edita posts desde la interfaz de Decap CMS en /admin.</p>
    </div>
    <div class="feature">
      <h2>Responsivo</h2>
      <p>Diseñado con enfoque mobile-first para móvil y desktop.</p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 4.5rem 0;
    text-align: center;
    background: linear-gradient(180deg, var(--color-bg-soft), var(--color-bg));
    border-bottom: 1px solid var(--color-border);
  }

  .hero__eyebrow {
    display: inline-block;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
  }

  .hero__lead {
    max-width: 38rem;
    margin: 0 auto 2rem;
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .features {
    display: grid;
    gap: 1.25rem;
    padding-block: 3.5rem;
  }

  .feature {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-soft);
  }

  .feature h2 {
    font-size: 1.25rem;
  }

  .feature p {
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (min-width: 48rem) {
    .hero {
      padding: 7rem 0;
    }

    .features {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
</style>
